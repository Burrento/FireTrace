# Off unless set. Turn it on for local work: it is what serves uploaded report
# photos back from MEDIA_ROOT, and what auto-trusts this machine's LAN IPs so a
# phone can reach the dev server. Never set this in a deployment.
DEBUG=True

DB_NAME=firetrace_db
DB_USER=postgres
DB_PASSWORD=12345
DB_HOST=localhost
DB_PORT=5432
GOOGLE_MAPS_API_KEY=

# Duplicate flagging. A report is flagged as a possible duplicate only when it
# is within BOTH thresholds of an earlier one. Flagging never merges or deletes
# anything — BFP personnel always make the call. Defaults shown.
# DUPLICATE_RADIUS_METERS=150
# DUPLICATE_TIME_WINDOW_MINUTES=30

# Geocoding confidence bands, in metres of reported GPS accuracy. Reports
# graded Low are kept and reviewable but are not plotted on the dashboard map.
# GEO_HIGH_ACCURACY_M=50
# GEO_MEDIUM_ACCURACY_M=200

# Comma-separated, no spaces. Defaults already cover localhost and tunnel
# domains, so you only need this when adding a LAN IP for phone testing:
#   ALLOWED_HOSTS=localhost,127.0.0.1,.trycloudflare.com,192.168.1.22
# ALLOWED_HOSTS=

# Comma-separated exact origins. LAN and tunnel origins are matched by regex in
# settings.py, so this is only for anything outside those patterns.
# CORS_ALLOWED_ORIGINS=http://localhost:5173
