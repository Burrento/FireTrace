DB_NAME=firetrace_db
DB_USER=postgres
DB_PASSWORD=12345
DB_HOST=localhost
DB_PORT=5432
GOOGLE_MAPS_API_KEY=

# Comma-separated, no spaces. Defaults already cover localhost and tunnel
# domains, so you only need this when adding a LAN IP for phone testing:
#   ALLOWED_HOSTS=localhost,127.0.0.1,.trycloudflare.com,192.168.1.22
# ALLOWED_HOSTS=

# Comma-separated exact origins. LAN and tunnel origins are matched by regex in
# settings.py, so this is only for anything outside those patterns.
# CORS_ALLOWED_ORIGINS=http://localhost:5173
